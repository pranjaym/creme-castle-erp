# Copy to .env.local and fill in. NEVER commit real values. Names only here.
#
# The portal is a window onto the spine. It signs users in with Supabase Auth
# (in the spine project) and reads spine data server-side. It never writes.

# --- Spine Supabase project ---
# Public URL and publishable (anon) key: safe to expose to the browser. Used for
# the login session (cookie based). Supabase: Project Settings > API.
NEXT_PUBLIC_SPINE_SUPABASE_URL=
NEXT_PUBLIC_SPINE_SUPABASE_ANON_KEY=

# Service role (secret) key: SERVER ONLY, never shipped to the browser. Used for
# privileged reads (storage bucket listing, report exports). New API-keys system
# value looks like sb_secret_...  (Project Settings > API > Secret keys).
SPINE_SUPABASE_SERVICE_ROLE_KEY=

# (No longer used by the portal.) Report downloads now read public views
# (migration 041) over the Supabase REST API using the keys above, so a direct
# database connection is not needed. Left here only as a note; safe to omit.
# SPINE_DATABASE_URL=

# Storage bucket that holds the built daily dashboards (cc_daily_<date>.html).
# The daily run uploads here; the portal lists and serves from here.
DASH_HTML_BUCKET=dashboard-html

# --- App ---
NODE_ENV=development
SUPPLYNOTE_API_KEY=   # read-only SupplyNote data API key, server-only (recipes module price fetch)

# --- Password reset by emailed link (9 Nov 2026) ---
# The company Google Workspace mailbox the reset emails come from, and a Google
# APP password for it (Google Account > Security > App passwords), never the
# mailbox's real password. Without these two, "Forgot password?" says email
# reset is not switched on yet, and admins set temporary passwords as before.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465),
# MAIL_FROM_NAME (default "Creme Castle ERP"), PORTAL_PUBLIC_URL (default
# https://creme-castle-erp.vercel.app, the address the emailed links point at).
# Local testing only: MAIL_DEV_OUTBOX=/some/folder writes emails there as .eml
# files instead of sending them (ignored in production).
